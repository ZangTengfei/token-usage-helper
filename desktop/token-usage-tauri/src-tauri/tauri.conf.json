{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Club Token 用量助手",
  "version": "0.5.20",
  "identifier": "club.changzhouai.usage.tauri",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utility",
    "icon": [
      "resources/icon.icns",
      "resources/icon.png"
    ],
    "resources": {
      "resources/collector/": "collector/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGRDM1MDM2MDczRUIwMzAKUldRd3NENEhObERUendKdVBsc3hVbTRKOW9OYmdoeVRVTzRnYXlXV2dmL3FSVnExQ25mbmI2Y2sK",
      "endpoints": [
        "https://assets.changzhouai.club/downloads/token-usage/updates/stable/{{target}}-{{arch}}.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
