{
  "name": "token-usage-helper",
  "version": "0.5.19",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm test --prefix desktop/token-usage",
    "test:native": "npm test --prefix desktop/token-usage-tauri",
    "test:collector": "node scripts/verify-token-usage-collector.mjs",
    "check:sources": "node scripts/sync-token-usage-sources.mjs --check",
    "build": "npm run build --prefix desktop/token-usage-tauri",
    "version:set": "node scripts/set-version.mjs",
    "desktop:release": "node --env-file-if-exists=.env.local scripts/desktop-release.mjs",
    "desktop:release:verify": "node --test scripts/desktop-release/*.test.mjs",
    "updater:publish": "node --env-file-if-exists=.env.local scripts/publish-token-usage-updater.mjs"
  },
  "devDependencies": {
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.100.1",
    "cos-nodejs-sdk-v5": "3.0.0",
    "sharp": "0.34.5"
  }
}
